rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'hamdansaleemi729@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidInquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
             data.projectType is string && data.projectType.size() > 0 && data.projectType.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['new', 'contacted', 'in_progress', 'closed'];
    }

    function isValidPortfolioConfig(data) {
      return data.brand is map &&
             data.contact is map &&
             data.founders is list &&
             data.services is list &&
             data.projects is list;
    }

    // 1. Studio Portfolio Data & Dynamic Configuration
    match /portfolio/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId) && isAdmin() && isValidPortfolioConfig(incoming());
      allow delete: if isValidId(configId) && isAdmin();
    }

    // 2. Client Project Inquiries & Inbound Briefs
    match /inquiries/{inquiryId} {
      // Inquiries contain potential client PII, only studio admins can read or list them
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      
      // Public prospective clients can create/submit project inquiries with strict payload validation
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      
      // Admins can update status, internal notes, or archive leads
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiry(incoming());
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 3. Admin User Access Directory
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminUid) && isAdmin();
    }
  }
}
